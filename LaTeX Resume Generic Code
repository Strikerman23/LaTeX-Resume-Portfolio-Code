\entry{\\Assessment of Machine Learning Classifiers for Heart Diseases Discovery}{Jul 2024 -- Nov 2024 \\ \textbf{Amrita Vishwa Vidyapeetham} \textbf{\textbar{}} \href{https://1drv.ms/f/c/b8d0d879c4c6b5cb/IgCI91qNtnAPT7mLq81K27vKAUrOPdrY2VWKqFYyFy8KVDU?e=OVkYFj}{Link}}
